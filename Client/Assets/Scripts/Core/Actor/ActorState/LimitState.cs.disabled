        //    m_actor.PlayAction("stand");
        //    floatingTime = 0;
        //}

        //hasInitFloatingPos = false;
        //m_actor.limitParam.iState = 0;
    }

    protected override void PreExiting()
    {
        m_isNonControl = false;
        base.PreExiting();
    }

