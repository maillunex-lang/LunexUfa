        private TweenPosition tp;
        //隐藏尸体
        void DelayHideModle()
        {
            if(null == m_actor)
            {
                return;
            }
            float downTime = 0;
            if (m_actor.mActorType == ActorType.AT_BOSS)
            {
                downTime = ConfigDataMgr.Instance.Consts.GetValue<float>(429, "fval");
            }
            else
            {
                downTime = ConfigDataMgr.Instance.Consts.GetValue<float>(430, "fval");
            }
            float downValue = ConfigDataMgr.Instance.Consts.GetValue<float>(431, "fval");
            Vector3 downPos = transform.position - new Vector3(0, downValue, 0);
            tp = TweenPosition.Begin(gameObject, downTime, downPos);

            Invoke("DeathEnd", downTime);
        }

        void DeathEnd()
        {
            m_isDeathEnd = true;
        }

        void OnDisable()
        {
            if (null != tp)
            {
                Destroy(tp);
            }

            m_isDeathEnd = true;
        }

