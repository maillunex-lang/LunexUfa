        //被击信息，动作，硬直时间，击退，击飞距离
        public class BehitInfo
        {
            public ActionAndTime[] strActionArry;
            public float NonControlTime;
            public float hitDistance;

            //小退位移
            public float moveDistance;
            public float moveTime;

            //退出被击状态时间
            public float exitStateTime;

            //是否浮空
            public bool isInSky;
        };

