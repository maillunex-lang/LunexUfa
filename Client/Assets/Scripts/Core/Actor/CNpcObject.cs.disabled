        //生物id
        public override void Init(int resID, int configID, long entityID, string strEnterAction = "", bool isNpc = false)
        {
              InitAutoMove();

            base.Init(resID, configID, entityID, strEnterAction, isNpc);
           
            m_TeamType = 2;
            m_ActorType = ActorType.AT_NPC;

            m_move = this.gameObject.GetComponent<ServerPlayerMove>();
            if(m_move == null)
            {
                m_move = this.gameObject.AddComponent<ServerPlayerMove>();
            }
            m_move.DoInit(this);

            // m_heath = this.gameObject.AddComponent<PlayerHeath>();

            LuaTable npcCfg = ConfigDataMgr.Instance.Actor.GetNPCConfig(configID);
            m_Type = NPC_Type.NT_NONE;
            if (null != npcCfg)
            {
                m_Type = (NPC_Type)npcCfg.Get<int>("type");
                if (m_Type == NPC_Type.NT_ACTIVITY)
                {
                    if (null == m_EffectObj)
                    {
                        m_EffectObj = CoreEntry.gGameObjPoolMgr.Instantiate("Effect/scene_vfx/fazhen_vfx");
                    }
                    if (null != m_EffectObj)
                    {
                        m_EffectObj.transform.parent = transform;
                        m_EffectObj.transform.localPosition = new Vector3(0, 0.1f, 0);
                        m_EffectObj.transform.localRotation = Quaternion.identity;
                    }
                }
            }

            //初始化后回调
            {
                OnPostInit();
            }

            CommonTools.SetLayer(this.gameObject, LayerMask.NameToLayer("npc"));
            CommonTools.SetTag(this.gameObject, "npc");
        }

